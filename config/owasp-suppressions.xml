<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        OWASP Dependency Check — Suppressed False Positives

        Add entries here for CVEs that have been reviewed and determined to be
        false positives or not applicable to this project.

        Example suppression:
        <suppress>
            <notes><![CDATA[
                This CVE applies to the standalone server distribution, not the client library
                used in this project. Reviewed 2026-03-17.
            ]]></notes>
            <cve>CVE-2024-XXXXX</cve>
        </suppress>

        Example suppression by GAV (Group:Artifact:Version):
        <suppress>
            <notes><![CDATA[
                False positive — CPE mismatch. The library "foo" is not the same as
                the vulnerable product "foo" in the NVD. Reviewed 2026-03-17.
            ]]></notes>
            <gav regex="true">^com\.example:foo:.*$</gav>
            <cve>CVE-2024-YYYYY</cve>
        </suppress>
    -->
</suppressions>
